{
  "info": {
    "name": "TX2 E-commerce REST gRPC Kafka",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Runnable API contract. Run requests in order against a real stack. Creates one test product and an order; deletes the product at the end. No authentication for the local classroom demo."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18080"
    }
  ],
  "item": [
    {
      "name": "01 Gateway health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Gateway UP\",()=>pm.expect(pm.response.json().status).to.eql(\"UP\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 List products",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Product list\",()=>pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create isolated product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Postman test product\", \"price\": 19.95, \"stock\": 10}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const p=pm.response.json(); pm.collectionVariables.set(\"productId\",p.id); pm.test(\"Decimal price\",()=>pm.expect(p.price).to.eql(19.95));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Update product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Postman test product updated\", \"price\": 19.95, \"stock\": 10}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Updated name\",()=>pm.expect(pm.response.json().name).to.eql(\"Postman test product updated\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Reject invalid product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"\", \"price\": -1, \"stock\": -1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Reject zero quantity",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"productId\": {{productId}}, \"quantity\": 0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Reject missing product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"productId\": 9223372036854775807, \"quantity\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\",()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Reject insufficient stock",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"productId\": {{productId}}, \"quantity\": 11}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\",()=>pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Create order via gRPC",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"productId\": {{productId}}, \"quantity\": 3}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const o=pm.response.json(); pm.collectionVariables.set(\"orderId\",o.id);",
              "pm.test(\"Exact total 59.85\",()=>pm.expect(o.totalPrice).to.eql(59.85));",
              "pm.test(\"Initially pending\",()=>pm.expect(o.status).to.eql(\"PENDING\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Await Kafka confirmation",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orders/{{orderId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const o=pm.response.json();",
              "let attempts=Number(pm.collectionVariables.get(\"attempts\")||0);",
              "if(o.status===\"PENDING\" && attempts<30){pm.collectionVariables.set(\"attempts\",attempts+1);pm.execution.setNextRequest(\"10 Await Kafka confirmation\");}",
              "else {pm.collectionVariables.unset(\"attempts\");pm.test(\"Order confirmed by inventory result\",()=>pm.expect(o.status).to.eql(\"CONFIRMED\"));}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(()=>{},500);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Verify async stock deduction",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Stock 10 - 3 = 7\",()=>pm.expect(pm.response.json().stock).to.eql(7));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 List orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Order persisted\",()=>pm.expect(pm.response.json().some(o=>String(o.id)===String(pm.collectionVariables.get(\"orderId\")))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Delete test product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\",()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Deleted product returns 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\",()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Reject invalid pagination",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products?size=1000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}