# Build from source: the host only needs Docker Desktop, not Java or Maven.
FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /workspace
ENV MAVEN_OPTS="-Xmx512m"
COPY pom.xml ./
COPY proto/pom.xml proto/product.proto ./proto/
COPY common/pom.xml ./common/
COPY product-service/pom.xml ./product-service/
COPY order-service/pom.xml ./order-service/
COPY api-gateway/pom.xml ./api-gateway/
COPY common/src ./common/src
COPY product-service/src ./product-service/src
COPY order-service/src ./order-service/src
COPY api-gateway/src ./api-gateway/src
RUN --mount=type=cache,target=/root/.m2 mvn -B -ntp -DskipTests package

FROM eclipse-temurin:17-jre-alpine
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app
ARG SERVICE
COPY --from=build /workspace/${SERVICE}/target/${SERVICE}-1.0.0.jar app.jar
USER app
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=65.0 -XX:InitialRAMPercentage=20.0" SERVER_PORT=8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=10 CMD wget -q -O - http://localhost:${SERVER_PORT}/actuator/health/readiness || exit 1
ENTRYPOINT ["java","-jar","/app/app.jar"]
